{
  "mcpServers": {
    "replybuddy": {
      "type": "streamable-http",
      "url": "https://mcp.replybuddy.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.replybuddy.io/oauth/authorize",
            "tokenUrl": "https://mcp.replybuddy.io/oauth/token",
            "registrationUrl": "https://mcp.replybuddy.io/oauth/register"
          }
        }
      }
    }
  }
}
